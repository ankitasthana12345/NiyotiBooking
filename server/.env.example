# MSSQL connection - SQL Server Authentication (recommended for servers)
# Uncomment and set these values for SQL auth
DB_DRIVER=tedious
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=AppointmentBookingDB
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
# Optional
DB_PORT=1433
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_TIMEOUT_MS=8000

# MSSQL connection - Windows Authentication using msnodesqlv8
# Uncomment to use Windows Integrated Auth (no DB_USER/DB_PASSWORD)
# Note: requires the msnodesqlv8 driver in package.json (already included)
# DB_DRIVER=msnodesqlv8
# DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost\SQLEXPRESS;Database=AppointmentBookingDB;Trusted_Connection=Yes;TrustServerCertificate=Yes;
# DB_TIMEOUT_MS=8000

# App settings
PORT=3000
SESSION_SECRET=change-me-now
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_MS=28800000

# CORS origin (set to your client origin in production)
CORS_ORIGIN=http://localhost:3000
