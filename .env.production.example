# Production template for the VPS. Copy to `.env` on the server and fill in
# real values — never commit the filled-in file.

NODE_ENV=production
PORT=3000

# Always use tedious (SQL auth) in production, whether the DB is a Linux
# Docker container (DEPLOYMENT.md) or a native SQL Server Express install on
# the Windows VPS (WINDOWS_DEPLOYMENT.md) — msnodesqlv8 is Windows-auth-only
# and reserved for local LocalDB dev.
DB_DRIVER=tedious
DB_DATABASE=AppointmentBookingDB
# DB_SERVER isn't listed here because it differs by setup: "mssql" for the
# Docker Compose path, "localhost" for the native Windows VPS install.
DB_SERVER=localhost
DB_USER=sa
DB_PASSWORD=replace_with_a_strong_password
DB_TIMEOUT_MS=8000
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_MS=28800000

CORS_ORIGIN=https://niyotishrivastava.com,https://www.niyotishrivastava.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
RESET_PASSWORD_BASE_URL=https://niyotishrivastava.com/reset-password.html

ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional — leave blank to skip WhatsApp notifications
WHATSAPP_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
