# Production template for the VPS. Copy to `.env` on the server and fill in
# real values — never commit the filled-in file.

NODE_ENV=production
PORT=3000

# GoDaddy injects these when a hosted MySQL database is attached.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_TIMEOUT_MS=8000

SESSION_SECRET=replace_with_a_long_random_secret
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_MS=28800000

CORS_ORIGIN=https://niyotishrivastava.com,https://www.niyotishrivastava.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
RESET_PASSWORD_BASE_URL=https://niyotishrivastava.com/reset-password.html

ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional — leave blank to skip WhatsApp notifications
WHATSAPP_API_VERSION=v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
