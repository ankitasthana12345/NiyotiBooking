NODE_ENV=development
PORT=3000

DB_DRIVER=tedious
DB_SERVER=localhost\\SQLEXPRESS
DB_DATABASE=AppointmentBookingDB
DB_USER=
DB_PASSWORD=
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Set DB_DRIVER=msnodesqlv8 and DB_CONNECTION_STRING for Windows Authentication
DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost\\SQLEXPRESS;Database=AppointmentBookingDB;Trusted_Connection=Yes;TrustServerCertificate=Yes;

SESSION_SECRET=replace_with_secure_secret
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_MS=28800000

CORS_ORIGIN=http://localhost:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
ADMIN_NOTIFICATION_EMAIL=
RESET_PASSWORD_BASE_URL=http://localhost:3000/reset-password.html

ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
